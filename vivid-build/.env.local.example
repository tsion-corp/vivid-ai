# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# The Vivid Builder API, as the relay in /api/vivid/* sees it. Required, and
# server-only: this is the value the route handler forwards to.
VIVID_API_BASE=https://vivid.tsionark.io/v1

# Optional, and off by default. Set it to the SAME URL as VIVID_API_BASE to have
# the browser call the API directly instead of through /api/vivid/*.
#
# Only turn this on once this app's origin is in the backend's CORS_ORIGINS —
# before that, every request fails. See BACKEND-CORS-FIX.md.
#
# Why it is worth turning on: a build turn streams for 15-25 minutes, and a
# serverless function cannot hold a response that long (Vercel: 300s on Hobby,
# 800s on Pro). Direct, there is no function in the path and no cap.
# NEXT_PUBLIC_VIVID_API_BASE=https://vivid.tsionark.io/v1

# Decane, from the Decane dashboard. Both server-only.
# DECANE_API_KEY is a secret (dck_live_…) and must never reach a browser.
DECANE_APP_ID=
DECANE_API_KEY=

# Optional: ES256 SPKI PEM. Set it to verify Decane tokens offline instead of
# fetching the JWKS.
# DECANE_VERIFICATION_KEY=

# Needed only for "Continue with Google". decane-node cannot run Google's
# redirect flow, so the browser gets the Google ID token and hands it to
# /api/auth/google. Email sign-in works without this.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
