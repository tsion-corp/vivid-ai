# Copy to /opt/vivid/app.env on the instance. Backend and worker read it.
# Runtime secrets and the model service URLs only: infrastructure wiring
# (DATABASE_URL, REDIS_URL, S3_*, SANDBOX_URL, VIVID_TOOLS_URL) is set by
# docker-compose.prod.yml and anything you put here for those is overridden.
#
# Not in git. chmod 600 it, and keep the master copy in a password manager or
# AWS Secrets Manager.

# Signs access tokens. Generate with: openssl rand -hex 32
JWT_SECRET=
# Operator view of /v1/health/models and /v1/health/code (which provider and
# model serve each role, the OpenRouter balance, the key's expiry), sent as
# Authorization: Bearer <HEALTH_TOKEN>. Empty = never shown. openssl rand -hex 24
HEALTH_TOKEN=
# Reads the waitlist: GET /v1/waitlist with Authorization: Bearer <ADMIN_TOKEN>.
# Empty = nobody can read it. openssl rand -hex 24
ADMIN_TOKEN=

# CORS is a JSON list, because pydantic-settings parses list fields as JSON.
# A bare comma-separated string will fail to start.
CORS_ORIGINS=["https://app.example.com"]

# GPU-down switch. runpod = the pods below; openrouter = chat, the coder,
# speech-to-text and text-to-speech go to OpenRouter with OPENROUTER_API_KEY.
# Change it, restart backend + worker, nothing client-side changes. Per-service
# overrides (LLM_PROVIDER, CODE_LLM_PROVIDER, ASR_PROVIDER, TTS_PROVIDER) move
# one service at a time. Translation (yo/ig) has no hosted fallback: it drops
# to English while its pod is down. See docs/DEPLOY.md.
MODEL_PROVIDER=runpod
OPENROUTER_API_KEY=
# OPENROUTER_CHAT_MODEL=google/gemma-3-27b-it
# OPENROUTER_CODE_MODEL=mistralai/devstral-2512
# OPENROUTER_STT_MODEL=openai/whisper-large-v3
# OPENROUTER_TTS_MODEL=hexgrad/kokoro-82m
# OPENROUTER_TTS_VOICE=af_heart
# Image and video generation always use OpenRouter (the pods have no such
# model) and need the key above. ~$0.003 an image; video priced per clip.
# OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
# OPENROUTER_VIDEO_MODEL=google/veo-3.1-fast
# OPENROUTER_VIDEO_MAX_SECONDS=5

# Per-credential ceilings for the partner generation and tool endpoints. Their
# own buckets because each call is priced by an upstream. Raise for a partner
# who asks; the defaults exist to bound a runaway loop.
# GENERATION_RATE_LIMIT_PER_MINUTE=20
# TOOL_RATE_LIMIT_PER_MINUTE=60

# --- Storage -----------------------------------------------------------
# "s3" (MinIO on the box) or "cloudinary" (CDN in front). Cloudinary is the
# reason images stop being a round trip to this one VPS; it also removes the
# need for the storage.<domain> hostname, because delivery URLs are plain
# public URLs rather than presigned ones whose signature covers the host.
#
# Switching does NOT move objects already in MinIO. Anything uploaded before
# the switch stays there and stops resolving unless it is migrated.
STORAGE_DRIVER=s3

# Only read when STORAGE_DRIVER=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vivid
# Empty delivers from res.cloudinary.com directly. To put a CDN in front,
# point it at res.cloudinary.com as origin and set the hostname here. Include
# the cloud name, exclude the resource type — the driver appends
# /image/upload/... itself.
#   direct:  https://res.cloudinary.com/<cloud-name>
#   Fastly:  https://cdn.example.com/<cloud-name>
CLOUDINARY_MEDIA_BASE_URL=

# Model services on RunPod. LLM_BASE_URL includes /v1.
LLM_BASE_URL=
LLM_MODEL=RedHatAI/gemma-3-27b-it-quantized.w4a16
ASR_BASE_URL=
TTS_BASE_URL=
TRANSLATE_BASE_URL=
EMBEDDINGS_URL=
RERANKER_URL=

# Tool loop. Credits per web_search = SEARCH_QUERY_VARIANTS x (2 advanced, 1 basic).
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
SEARCH_QUERY_VARIANTS=3

# Shared secret for the vivid-tools browser service. Must match BROWSER_TOKEN
# in /opt/vivid/.env, which is what vivid-tools itself checks.
VIVID_TOOLS_TOKEN=

# Decane auth, if in use.
DECANE_APP_ID=
DECANE_VERIFICATION_KEY=
# Decane sign-in for the apps the builder makes (organization token from
# dashboard.decane.app -> Organization; scopes clients:read, clients:write,
# keys:write). Server-only; never in an app.
DECANE_PARTNER_TOKEN=

# Generation limits. Defaults live in app/core/config.py; override as needed.
# LLM_CONTEXT_TOKENS=8192
# MAX_REPLY_TOKENS=4096
# RATE_LIMIT_PER_MINUTE=20

# --- Mobile apps (Expo) -------------------------------------------------
# Mobile projects run in the vivid-expo E2B template (build it once with
# sandbox-templates/vivid-expo/template.py and the same E2B_API_KEY).
# E2B_MOBILE_TEMPLATE=vivid-expo
# Vivid's own Expo account for builds users pay for: a robot token from
# expo.dev (Account settings -> Access tokens) and the account that owns the
# apps. Empty = only builds on a user's own connected Expo account work.
EXPO_TOKEN=
EXPO_OWNER=
# Expo Go on phones goes through the http relay in the host's Caddy (see
# vivid-backend/docs/builder.md). sslip.io needs no DNS: <ip-with-dashes>.sslip.io.
# EXPO_DEVICE_RELAY_DOMAIN=170-75-171-250.sslip.io
# Price per build on Vivid's account, in kobo (500000 = N5,000), and the
# monthly cap of such builds per user.
# EAS_VIVID_BUILDS_PER_MONTH=5

# --- Wallet (users pay Vivid) -------------------------------------------
# Bank transfers: Pouch (Liquifia fiat API) secret key; each user gets a
# Nigerian virtual account. Webhook: PUBLIC_BASE_URL/v1/webhooks/pouch.
POUCH_API_KEY=
POUCH_WEBHOOK_SECRET=
# Crypto: Dextopus integration key, and Vivid's USDC treasury address on
# Base that every deposit settles to. Set default refund addresses in the
# Dextopus dashboard. Webhook: PUBLIC_BASE_URL/v1/webhooks/dextopus.
DEXTOPUS_API_KEY=
DEXTOPUS_WEBHOOK_SECRET=
DEXTOPUS_SETTLEMENT_ADDRESS=
# After setting the keys: python -m app.scripts.wallet_setup (inside the
# backend container) registers both webhooks and prints the secrets.
# WALLET_FX_SPREAD_BPS=150
# Build prices in USD, debited from the wallet:
# EAS_BUILD_PRICE_ANDROID_USD=0.20   (launch; intended 2)
# EAS_BUILD_PRICE_IOS_USD=0.20       (launch; intended 4)

# --- Plans --------------------------------------------------------------
# Counted in credits: 1 credit = PLAN_TOKENS_PER_CREDIT builder tokens.
# Defaults: Free 2 apps, 20 credits a month (4 per 5 hours); Pro $32, 100
# a month (16 per 5h); Max $78, 200 a month (24 per 5h); extra credits $0.30 each. Tune from: python -m app.scripts.token_economics
# PLAN_TOKENS_PER_CREDIT=500000
# PLAN_FREE_MONTH_CREDITS=20
# PLAN_PRO_MONTH_CREDITS=100
# PLAN_MAX_MONTH_CREDITS=200
# PLAN_CREDIT_PRICE_USD=0.30

# --- Vivid Pay (payments for the apps users build) ----------------------
# Customers pay by bank transfer into an account made for their order
# (Pouch, same POUCH_* keys as the wallet); the owner's earnings get the
# money less the fee and are withdrawn to a Nigerian bank after a BVN check.
# VIVIDPAY_ENABLED=true
# VIVIDPAY_FEE_BPS=150            (1.5%)
# VIVIDPAY_MIN_FEE_KOBO=10000     (N100, covers moving the money)
# VIVIDPAY_FEE_CAP_KOBO=200000    (N2,000)
# VIVIDPAY_MIN_WITHDRAWAL_KOBO=100000
# VIVIDPAY_DAILY_WITHDRAWAL_KOBO=500000000
# VIVIDPAY_API_BASE=              (default PUBLIC_BASE_URL; apps call <base>/v1/pay)
