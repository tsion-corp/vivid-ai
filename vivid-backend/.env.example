# For running the backend OUTSIDE docker-compose (compose injects its own env).
ENV=development

DATABASE_URL=postgresql+asyncpg://vivid:vivid@localhost:5432/vivid
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-secret-change-me
# Unlocks the operator view of /v1/health/models (providers, models,
# OpenRouter balance and key expiry): Authorization: Bearer <HEALTH_TOKEN>.
HEALTH_TOKEN=dev-health-change-me

# Decane, two separate things.
# Vivid's own sign-in ("Continue with Google" on Vivid): the project id from
# dashboard.decane.app, and optionally its ES256 public key for offline token
# checks (empty = Decane's JWKS). Empty DECANE_APP_ID turns the login off.
DECANE_APP_ID=
DECANE_VERIFICATION_KEY=
# Sign-in for the apps the builder makes: the organization token (dck_org_...)
# from dashboard.decane.app -> Organization -> Generate token, with scopes
# clients:read, clients:write and keys:write. It gives each project its own
# Decane client. Server-only; never in an app or a sandbox. Empty turns the
# per-project Sign-in toggle off.
DECANE_PARTNER_TOKEN=

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vivid

# Where model calls go: runpod (our pods, below) or openrouter (hosted fallback
# for when the GPUs are down). Flip, set the key, restart — history, prompts
# and budgets stay here, and the frontend, the /v1 aliases and Vivid Code
# notice nothing. Moves chat, the coder, speech-to-text and text-to-speech;
# translation (yo/ig) falls back to English while its pod is down.
MODEL_PROVIDER=runpod
# Per-service overrides; empty = follow MODEL_PROVIDER.
LLM_PROVIDER=
CODE_LLM_PROVIDER=
ASR_PROVIDER=
TTS_PROVIDER=
OPENROUTER_API_KEY=
# The defaults, spelled out so a flip is one line. One assignment per line:
# dotenv reads everything after `=` as the value.
OPENROUTER_CHAT_MODEL=google/gemma-3-27b-it
OPENROUTER_CHAT_CONTEXT_TOKENS=131072
OPENROUTER_CODE_MODEL=mistralai/devstral-2512
OPENROUTER_CODE_CONTEXT_TOKENS=262144
OPENROUTER_STT_MODEL=openai/whisper-large-v3
OPENROUTER_TTS_MODEL=hexgrad/kokoro-82m
OPENROUTER_TTS_VOICE=af_heart
OPENROUTER_TTS_SAMPLE_RATE=24000
# Which host serves the LLMs on OpenRouter; empty = OpenRouter's own routing.
OPENROUTER_PROVIDER_SORT=latency
# Image and video generation (generate_image / generate_video tools). Always
# OpenRouter, whatever MODEL_PROVIDER says; the tools exist while the key is
# set. Nothing there is free: ~$0.003 an image on flux.2 klein, video per clip.
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
OPENROUTER_VIDEO_MODEL=google/veo-3.1-fast
OPENROUTER_VIDEO_MAX_SECONDS=5

# Model services on RunPod
LLM_BASE_URL=https://qwxeep3sudzk43-8002.proxy.runpod.net
LLM_MODEL=RedHatAI/gemma-3-27b-it-quantized.w4a16
# The coding pod, served at /v1 as `vivid-code`. Empty falls back to the chat
# pod above, so a single-pod deployment still answers the alias.
CODE_LLM_BASE_URL=
CODE_LLM_MODEL=
CODE_LLM_CONTEXT_TOKENS=100000
ASR_BASE_URL=
TTS_BASE_URL=
EMBEDDINGS_URL=
RERANKER_URL=

# Tool loop
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
SEARCH_QUERY_VARIANTS=3
