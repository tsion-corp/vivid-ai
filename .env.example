# Copy to .env at the repo root. docker-compose interpolates these into the
# backend and worker containers. All model traffic goes through the backend —
# these URLs must never reach the frontend.

# vLLM OpenAI-compatible root, INCLUDING /v1
# e.g. https://<pod-id>-8000.proxy.runpod.net/v1
LLM_BASE_URL=
LLM_MODEL=RedHatAI/gemma-3-27b-it-quantized.w4a16

# STT server: /transcribe (supports lang=auto) — e.g. https://<pod>-8002.proxy.runpod.net
ASR_BASE_URL=

# TTS server: /speak — e.g. https://<pod>-8003.proxy.runpod.net
# (text cleanup for TTS now lives in the backend, so call it directly)
TTS_BASE_URL=

# MADLAD translate server: /translate — e.g. https://<pod>-8004.proxy.runpod.net
TRANSLATE_BASE_URL=

# Tavily key for the backend tool loop's web_search/news; other tools
# (weather, rates, crypto, wikipedia, calculate, now) need no key.
TAVILY_API_KEY=
# Search cost dials: credits per web_search = SEARCH_QUERY_VARIANTS x
# (2 for advanced, 1 for basic). Defaults: 3 x advanced = 6 credits/search.
TAVILY_SEARCH_DEPTH=advanced
SEARCH_QUERY_VARIANTS=3

# Reranker (BGE-reranker-v2-m3 behind text-embeddings-inference, base URL
# without /rerank) — not deployed yet; leave empty (Tavily's order is used).
# e.g. https://<pod>-8006.proxy.runpod.net
RERANKER_URL=

# Embeddings service — not deployed yet; leave empty (search falls back to
# Postgres full-text).
EMBEDDINGS_URL=

JWT_SECRET=dev-secret-change-me

# Decane, two separate things.
# Vivid's own sign-in ("Continue with Google" on Vivid): the project id from
# dashboard.decane.app, and optionally its ES256 public key for offline token
# checks (empty = Decane's JWKS). Empty DECANE_APP_ID turns the login off.
DECANE_APP_ID=
DECANE_VERIFICATION_KEY=
# Sign-in for the apps the builder makes: the organization token (dck_org_...)
# from dashboard.decane.app -> Organization -> Generate token, with scopes
# clients:read, clients:write and keys:write. It gives each project its own
# Decane client. Server-only; never in an app or a sandbox. Empty turns the
# per-project Sign-in toggle off.
DECANE_PARTNER_TOKEN=

# --- The app builder (vivid-backend/docs/builder.md) ---------------------
# Models by stage, all OpenRouter slugs. OPENROUTER_API_KEY above is required.
PLAN_MODEL=deepseek/deepseek-v4.1-flash
BUILD_MODEL=deepseek/deepseek-v4.1-flash
EDIT_MODEL=deepseek/deepseek-v4.1-flash
FALLBACK_MODEL=z-ai/glm-5.3-flash
# Where the user's app runs: e2b (production) or local (dev only).
SANDBOX_DRIVER=e2b
E2B_API_KEY=
E2B_TEMPLATE=vivid-web
# Snapshots in Cloudflare R2 (S3-compatible). Empty = the S3_* MinIO above.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=vivid-builder/
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
# Connect Supabase button: an OAuth app registered at supabase.com/dashboard/org/_/apps
# with redirect URL <PUBLIC_BASE_URL>/v1/connectors/supabase/callback. Empty = only
# pasted personal access tokens work.
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
# Publishing: an API token with "Cloudflare Pages: Edit" on the account.
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_PAGES_PROJECT=vivid-apps
